{
    "name": "weijukeji/laravel-apifox-sync",
    "description": "Laravel package for syncing OpenAPI JSON files to Apifox",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "apifox",
        "openapi",
        "api-documentation",
        "weijukeji"
    ],
    "authors": [
        {
            "name": "WeiJuKeJi",
            "email": "dev@weijukeji.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Weijukeji\\LaravelApifoxSync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Weijukeji\\LaravelApifoxSync\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Weijukeji\\LaravelApifoxSync\\ApifoxSyncServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
